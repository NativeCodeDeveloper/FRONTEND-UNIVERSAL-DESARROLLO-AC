# Variables del front (Vercel → Settings → Environment Variables, una por instancia).
# Copiar a .env para desarrollo local. NUNCA subir el .env al repo.
#
# OJO: todo lo que empieza con NEXT_PUBLIC_ queda VISIBLE en el navegador de cualquiera.
# Jamás poner un secreto en una variable NEXT_PUBLIC_.
# Marcas: [obligatoria]/[opcional] · [secreto] nueva por instancia · [instancia] cambia por clínica · [fija]
# Las del backend se revisan con node scripts/revisar_env.mjs (repo del backend).

# ── Conexión con el backend ───────────────────────────────────────────────────
# [obligatoria][instancia] Con las dos barras: https://back.clinica.agendaclinicas.cl (sin barra final).
# Debe estar también en CORS_ORIGENES del backend el dominio de ESTE front.
NEXT_PUBLIC_API_URL=
# [obligatoria][instancia] Dominio público de este front (metadatos y enlaces). Sin él usa https://agendaclinica.cl.
NEXT_PUBLIC_SITE_URL=

# ── Sesión (Clerk) — misma instancia de Clerk que el CLERK_SECRET_KEY del backend ──
# [obligatoria][instancia] pk_live_… (es pública por diseño).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [obligatoria][secreto] sk_live_… Lo usa "Crear usuarios" del dashboard (rutas /api del servidor de Next).
# En Clerk, Restrictions → Sign-up mode debe quedar en "Restricted": las cuentas se crean desde el dashboard.
CLERK_SECRET_KEY=

# ── Imágenes (Cloudflare Images) ──────────────────────────────────────────────
# [obligatoria][instancia] Hash de entrega (el mismo ACCOUNT_HASH del backend). Sin él usa uno fijo del código.
NEXT_PUBLIC_CLOUDFLARE_HASH=

# ── Interruptores ─────────────────────────────────────────────────────────────
# [obligatoria][fija] "1": política de privacidad y consentimientos contra el servidor (Ley 21.719).
NEXT_PUBLIC_CONSENTIMIENTOS_HABILITADOS=1
# [obligatoria][fija] "1": firma electrónica real.
NEXT_PUBLIC_FIRMA_HABILITADA=1
# [opcional][fija] SOLO para pruebas locales: simula la firma sin backend. JAMÁS en Vercel.
NEXT_PUBLIC_FIRMA_MOCK=
# [opcional][fija] SOLO pruebas locales con el simulador: fuerza la pantalla de reverificación.
NEXT_PUBLIC_FIRMA_MOCK_REVERIFICACION=

# ── Datos de respaldo del sitio público (se usan si la clínica no los cargó en el dashboard) ──
# [opcional][instancia]
NEXT_PUBLIC_EMPRESA_NOMBRE=
# [opcional][instancia]
NEXT_PUBLIC_CONTACT_PHONE=
# [opcional][instancia]
NEXT_PUBLIC_CONTACT_WHATSAPP=
# [opcional][instancia]
NEXT_PUBLIC_CONTACT_EMAIL=
# [opcional][instancia]
NEXT_PUBLIC_CONTACT_ADDRESS=
# [opcional][instancia]
NEXT_PUBLIC_CONTACT_MAPS_URL=
# [opcional][instancia]
NEXT_PUBLIC_ABOUT_TITLE=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_INSTAGRAM_HANDLE=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_TWITTER_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_TIKTOK_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_OTHER_URL=
# [opcional][instancia]
NEXT_PUBLIC_SOCIAL_OTHER_LABEL=
# [opcional][instancia] Correo que muestra la página de pago aprobado.
CORREO_OFICIAL=
